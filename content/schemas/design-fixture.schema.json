{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mythical-dnd:design-fixture:v1",
  "title": "Design reference fixture, not a compiled runtime pack",
  "type": "object",
  "properties": {
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "string",
      "const": "design-reference-not-runtime-pack"
    },
    "source_modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "settlements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "playable-center",
              "local-community",
              "external-boundary"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "region_id",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "households": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "settlement_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "settlement_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "household_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "household_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "cost_status": {
            "const": "to-author-before-runtime"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "cost_status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "professions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "fixture_id",
    "schema_version",
    "status",
    "source_modules",
    "regions",
    "settlements",
    "households",
    "actors",
    "routes",
    "professions",
    "threads",
    "notes"
  ],
  "additionalProperties": false
}
