  "initial_projection": {
    "tick": 0,
    "lots": {
      "household": {
        "on_hand": 10,
        "reserved": 0
      },
      "worker": {
        "on_hand": 0,
        "reserved": 0
      }
    },
    "item": {
      "owner": "actor_1",
      "condition": 400
    },
    "jobs": [],
