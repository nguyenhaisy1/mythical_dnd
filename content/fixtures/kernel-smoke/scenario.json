      "world_tick": 0,
      "payload": {
        "actor_id": "actor_1",
        "item_id": "boat",
        "material_lot_id": "worker_lot",
        "recipe_id": "recipe.boat-repair@1"
      },
      "expected": {
        "outcome": "Accepted",
        "revision": 2,
        "worker_reserved": 2,
        "worker_on_hand": 4,
        "due_tick": 60,
        "activity": "Running",
        "event": "RepairStarted"
      }
    },
    {
      "command_id": "smoke_3",
      "command_type": "AdvanceTime",
      "expected_revision": 2,
      "world_tick": 0,
      "payload": {
        "target_tick": 60
      },
      "expected": {
        "outcome": "Accepted",
        "revision": 5,
        "commit_sequence": [
          "request_target_revision_3",
          "complete_repair_revision_4",
          "close_workflow_revision_5"
        ],
        "tick": 60,
        "worker_on_hand": 2,
        "worker_reserved": 0,
        "condition": 600,
        "activity": "Completed",
        "jobs": []
      }
    },
    {
      "command_id": "smoke_4",
      "command_type": "TransferItemRights",
      "expected_revision": 5,
      "world_tick": 60,
      "payload": {
        "item_id": "boat",
        "new_owner_id": "actor_2"
      },
      "expected": {
        "outcome": "Accepted",
        "revision": 6,
        "owner": "actor_2",
        "event": "ItemRightsTransferred"
      }
    }
  ],
  "negative_cases": [
    {
      "case": "insufficient",
      "from": "initial",
      "command": "TransferResource quantity=11",
      "expected": "INSUFFICIENT_RESOURCE; no revision/RNG/allocation change"
    },
    {
      "case": "duplicate",
      "from": "after smoke_1",
      "command": "retry identical smoke_1 envelope",
      "expected": "same receipt; household=6 worker=4 revision=1"
    },
    {
      "case": "mismatch",
      "from": "after smoke_1",
      "command": "smoke_1 with quantity=3",
      "expected": "CMD_PAYLOAD_MISMATCH; state unchanged"
    },
    {
      "case": "stale",
      "from": "after smoke_1",
      "command": "new ID expected_revision=0",
      "expected": "STALE_REVISION; state unchanged"
    },
    {
      "case": "cancel",
      "from": "after smoke_2",
      "command": "CancelActivity new ID",
      "expected": "worker on_hand=4 reserved=0 condition=400; Cancelled; no job"
    },
    {
      "case": "death",
      "from": "after smoke_2",
      "command": "commit actor death before completion",
      "expected": "cancel/release; worker on_hand=4 reserved=0 condition=400; no dead worker completion"
    },
    {
      "case": "destroy_reserved",
      "from": "after smoke_2",
      "command": "destroy 2 reserved timber",
      "expected": "worker on_hand=2 reserved=0; activity Failed; condition=400; no refund"
    },
    {
      "case": "storage_failure",
      "from": "initial",
      "command": "TransferResource quantity=4 fail before commit",
